# Meta / Facebook Lead Ads Webhook Configuration
META_VERIFY_TOKEN=aeero_meta_lead_token_2026
META_PAGE_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Google Sheets Lead Bridge Configuration
GOOGLE_DRIVE_FOLDER_ID=
